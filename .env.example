# Copy to .env and fill in as needed. Every value has a sane default in
# controlplane/config.py — you only need to set what you're overriding.

# --- Redis / event bus ---------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Upstream providers (leave blank to use the offline mock:* provider) --
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# --- Proxy / dashboard ports ----------------------------------------------
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8090

# Optional: forward HIGH_RISK escalations to an external webhook (Slack,
# PagerDuty, ticketing system, ...) in addition to the built-in dashboard.
HITL_WEBHOOK_URL=

# --- Cost telemetry --------------------------------------------------------
COST_PER_1K_PROMPT_TOKENS=0.003
COST_PER_1K_COMPLETION_TOKENS=0.015
SESSION_BUDGET_USD=0.02
RATE_LIMIT_TOKENS_PER_MIN=20000

# --- Risk thresholds (Dynamic Action Engine) --------------------------------
HALLUCINATION_LOW_MAX=0.30
HALLUCINATION_HIGH_MIN=0.10
TOXICITY_MEDIUM_MIN=0.4
TOXICITY_HIGH_MIN=0.75

# --- Demo mode: fall back to the offline mock:* provider when no API key
# is configured for the requested provider, instead of erroring. ----------
CONTROLPLANE_DEMO_MODE=true

# Fast-path buffer size (characters) traded off between "zero latency" and
# "ability to mask/block inline" — see README Design Decisions.
FAST_PATH_BUFFER_CHARS=80
